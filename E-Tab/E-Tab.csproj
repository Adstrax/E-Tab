<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>false</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- A long-running tray app has no culture-sensitive UI beyond the
             static English strings it owns. Disabling ICU/globalization data
             trims startup time and the resident process footprint. -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Desktop GUI app: workstation, non-server GC, concurrent collection.
             Tiny heaps here, so a server GC would only waste memory. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <Version>7.0.0</Version>
        <AssemblyVersion>7.0.0.0</AssemblyVersion>
        <FileVersion>7.0.0.0</FileVersion>
        <RootNamespace>ETab</RootNamespace>
        <AssemblyName>E-Tab</AssemblyName>
        <Title>E-Tab</Title>
        <Description>Open folders in new File Explorer tabs.</Description>
        <Authors>E-Tab contributors</Authors>
        <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Icon.ico"/>
        <Resource Include="Icon-32.png"/>
    </ItemGroup>

    <!-- The window objects File Explorer hands out. The conversion is built on
         the shell telling this app that a window was registered, which is what
         these two carry; they are the same type libraries the reference
         implementation binds to, generated here so the build needs no Windows
         SDK of its own. -->
    <ItemGroup>
        <Reference Include="Interop.SHDocVw">
            <HintPath>..\libs\Interop.SHDocVw.dll</HintPath>
        </Reference>
        <Reference Include="Interop.Shell32">
            <HintPath>..\libs\Interop.Shell32.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
