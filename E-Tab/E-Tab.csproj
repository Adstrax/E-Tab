<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>false</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- A long-running tray app has no culture-sensitive UI beyond the
             static English strings it owns. Disabling ICU/globalization data
             trims startup time and the resident process footprint. -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Desktop GUI app: workstation, non-server GC, concurrent collection.
             Tiny heaps here, so a server GC would only waste memory. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

        <ApplicationIcon>Icon.ico</ApplicationIcon>
        <Version>5.6.1</Version>
        <AssemblyVersion>5.6.1.0</AssemblyVersion>
        <FileVersion>5.6.1.0</FileVersion>
        <RootNamespace>ETab</RootNamespace>
        <AssemblyName>E-Tab</AssemblyName>
        <Title>E-Tab</Title>
        <Description>Open folders in new File Explorer tabs.</Description>
        <Authors>E-Tab contributors</Authors>
        <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <ItemGroup>
        <Resource Include="Icon.ico"/>
        <Resource Include="Icon-32.png"/>
    </ItemGroup>

</Project>
