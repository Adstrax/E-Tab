<Window x:Class="ETab.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Tab 设置"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnTitleDrag">
    <Window.Resources>
        <Style x:Key="Win11ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Width="42"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#3A3F47"
                                    BorderBrush="#4A505A"
                                    BorderThickness="1"/>
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Fill="#F2F3F5"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0067C0"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0067C0"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="#20242A"
            BorderBrush="#3A3F47"
            BorderThickness="1"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="34"
                           Height="34"
                           Source="pack://application:,,,/Icon.ico"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="E-Tab 设置"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="文件夹打开为新标签页"
                                   Foreground="#A7ADB5"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Content="&#x2715;"
                        Width="32"
                        Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#A7ADB5"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="#12FFFFFF"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#4CC84C"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="已启用 · 新文件夹窗口自动转为标签页"
                               Foreground="#D7DADE"
                               FontSize="13"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="开机自动启动"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="登录 Windows 后自动在托盘运行 E-Tab"
                               Foreground="#A7ADB5"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="AutoStartToggle"
                              Style="{StaticResource Win11ToggleStyle}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="开机自动启动"
                              AutomationProperties.AutomationId="AutoStartToggle"
                              Checked="AutoStartToggle_Changed"
                              Unchecked="AutoStartToggle_Changed"/>
            </Grid>

            <TextBlock Grid.Row="3"
                       Text="E-Tab v1.0.6"
                       Foreground="#8A9099"
                       FontSize="11"
                       Margin="0,24,0,0"/>
        </Grid>
    </Border>
</Window>
