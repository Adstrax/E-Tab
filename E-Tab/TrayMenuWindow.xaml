<Window x:Class="ETab.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="E-Tab"
        Width="264"
        Height="172"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="#F026292F"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="8"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.45"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="8,10,8,8">
                <StackPanel Orientation="Horizontal">
                    <Image Width="28"
                           Height="28"
                           Source="pack://application:,,,/Icon.ico"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="E-Tab"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="v1.0.6"
                                   Foreground="#A7ADB5"
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#1FFFFFFF" Margin="8,0"/>

            <StackPanel Orientation="Horizontal" Margin="12,10,0,10">
                <Ellipse Width="8"
                         Height="8"
                         Fill="#4CC84C"
                         VerticalAlignment="Center"/>
                <TextBlock Text="已启用 · 文件夹打开为新标签页"
                           Foreground="#D7DADE"
                           FontSize="12.5"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <Border Height="1" Background="#1FFFFFFF" Margin="8,0"/>

            <Button x:Name="SettingsButton"
                    Content="设置"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="0,4,0,0"
                    AutomationProperties.Name="设置"
                    AutomationProperties.AutomationId="SettingsButton"
                    Click="SettingsButton_Click"/>
            <Button x:Name="ExitButton"
                    Content="退出"
                    Style="{StaticResource MenuButtonStyle}"
                    AutomationProperties.Name="退出"
                    AutomationProperties.AutomationId="ExitButton"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Border>
</Window>
