<Window x:Class="ETab.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating E-Tab"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border CornerRadius="10"
            Background="{DynamicResource EtabMenuOverlay}"
            BorderBrush="{DynamicResource EtabMenuBorderBrush}"
            BorderThickness="1"
            Padding="20,18">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="Updating E-Tab"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource EtabTextPrimary}"/>
            <TextBlock x:Name="StatusText"
                       Margin="0,10,0,0"
                       FontSize="12.5"
                       Foreground="{DynamicResource EtabTextSecondary}"
                       TextWrapping="Wrap"/>
            <ProgressBar x:Name="Progress"
                         Height="4"
                         Margin="0,16,0,0"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="False"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Padding="14,6"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Border>
</Window>
